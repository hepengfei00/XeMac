<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>org.local.wtl-cpu-temperature-check</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Library/Application Support/WTLArrowTiming.EXAMPLE/CPUTemperature.1/collect-nextboot.sh</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>ProcessType</key>
	<string>Background</string>
	<key>LowPriorityIO</key>
	<true/>
	<key>Nice</key>
	<integer>10</integer>
	<key>StandardOutPath</key>
	<string>/Library/Application Support/WTLArrowTiming.EXAMPLE/CPUTemperature.1/launchd.log</string>
	<key>StandardErrorPath</key>
	<string>/Library/Application Support/WTLArrowTiming.EXAMPLE/CPUTemperature.1/launchd.log</string>
</dict>
</plist>

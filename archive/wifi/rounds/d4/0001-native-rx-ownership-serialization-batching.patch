@@ -0,0 +1,175 @@
+/* SPDX-License-Identifier: GPL-2.0 OR BSD-3-Clause */
+// Included after RTWCore89 and the native networking declarations. The same
+// implementation is exercised by the host ownership/concurrency tests.
+
+bool RTWCore89::initializeNativeRx()
+{
+    if (!nativeRxLock) nativeRxLock = IOSimpleLockAlloc();
+    if (!nativeRxLock) return false;
+    nativeRxQueue.initialize();
+    nativeRxEvent = IOInterruptEventSource::interruptEventSource(
+        this, nativeRxAction, nullptr);
+    if (!nativeRxEvent) return false;
+    if (getMainWorkLoop()->addEventSource(nativeRxEvent) != kIOReturnSuccess) {
+        nativeRxEvent->release(); nativeRxEvent = nullptr;
+        return false;
+    }
+    nativeRxEvent->enable();
+    return true;
+}
+
+// No native gate is acquired by the producer. A provider-less interrupt event
+// source is IOKit's supported asynchronous software-event mechanism. Notify
+// while holding only the short queue lock, so removal cannot race notification.
+bool RTWCore89::enqueueNativeRx(void *opaque, void *storage, size_t length)
+{
+    auto *owner = static_cast<RTWCore89 *>(opaque);
+    if (!owner || !owner->nativeRxLock) return false;
+    IOSimpleLockLock(owner->nativeRxLock);
+    Rtw89NativeRx::Frame frame = {storage, length, owner->nativeRxQueue.generation()};
+    const bool accepted = owner->nativeRxQueue.push(frame);
+    if (accepted && owner->nativeRxEvent)
+        owner->nativeRxEvent->interruptOccurred(nullptr, nullptr, 0);
+    IOSimpleLockUnlock(owner->nativeRxLock);
+    return accepted;
+}
+
+bool RTWCore89::resumeNativeRx()
+{
+    if (!nativeRxLock) return false;
+    IOSimpleLockLock(nativeRxLock);
+    const bool resumed = nativeRxEvent && nativeRxQueue.resume();
+    IOSimpleLockUnlock(nativeRxLock);
+    return resumed;
+}
+
+void RTWCore89::pauseNativeRx()
+{
+    if (!nativeRxLock) return;
+    IOSimpleLockLock(nativeRxLock);
+    nativeRxQueue.pause();
+    if (nativeRxEvent && nativeRxQueue.needsService())
+        nativeRxEvent->interruptOccurred(nullptr, nullptr, 0);
+    IOSimpleLockUnlock(nativeRxLock);
+    // Make room for the next power/MAC session before hardware is restarted.
+    // Purge only stale entries; even a concurrent resume cannot lose new data.
+    for (;;) {
+        Rtw89NativeRx::Frame frame = {};
+        IOSimpleLockLock(nativeRxLock);
+        const bool found = nativeRxQueue.popStale(frame);
+        if (found) nativeRxQueue.noteDrained(false);
+        IOSimpleLockUnlock(nativeRxLock);
+        if (!found) break;
+        rtw89LinuxReleaseReceivedFrame(frame.storage);
+    }
+}
+
+void RTWCore89::requestNativeTx(bool unstall)
+{
+    if (!nativeRxLock) return;
+    IOSimpleLockLock(nativeRxLock);
+    if (nativeRxQueue.requestTx(unstall) && nativeRxEvent)
+        nativeRxEvent->interruptOccurred(nullptr, nullptr, 0);
+    IOSimpleLockUnlock(nativeRxLock);
+}
+
+void RTWCore89::requestNativeRxStatistics()
+{
+    if (!nativeRxLock) return;
+    IOSimpleLockLock(nativeRxLock);
+    if (nativeRxQueue.requestStats() && nativeRxEvent)
+        nativeRxEvent->interruptOccurred(nullptr, nullptr, 0);
+    IOSimpleLockUnlock(nativeRxLock);
+}
+
+void RTWCore89::stopNativeRx()
+{
+    if (!nativeRxLock) return;
+    IOSimpleLockLock(nativeRxLock);
+    nativeRxQueue.stop();
+    auto *event = nativeRxEvent;
+    nativeRxEvent = nullptr;
+    IOSimpleLockUnlock(nativeRxLock);
+    // Removal waits for an active native drain to finish. Never hold the queue
+    // lock across removal; IRQ/NAPI producers only need that short lock.
+    if (event) {
+        event->disable();
+        if (event->getWorkLoop()) event->getWorkLoop()->removeEventSource(event);
+        event->release();
+    }
+    for (;;) {
+        Rtw89NativeRx::Frame frame = {};
+        IOSimpleLockLock(nativeRxLock);
+        const bool found = nativeRxQueue.pop(frame);
+        IOSimpleLockUnlock(nativeRxLock);
+        if (!found) break;
+        rtw89LinuxReleaseReceivedFrame(frame.storage);
+    }
+    // The lock outlives all producer callbacks. free() releases it only after
+    // transport teardown has joined the IRQ/NAPI callbacks.
+}
+
+void RTWCore89::nativeRxAction(OSObject *object, IOInterruptEventSource *, int)
+{
+    auto *owner = static_cast<RTWCore89 *>(object);
+    owner->drainNativeRx();
+}
+
+void RTWCore89::drainNativeRx()
+{
+    if (!getMainWorkLoop()->inGate()) {
+        __sync_fetch_and_add(&nativeRxGateViolations, 1);
+        return;
+    }
+    struct mbuf_list batch;
+    ml_init(&batch);
+    IOSimpleLockLock(nativeRxLock);
+    const uint32_t epoch = nativeRxQueue.generation();
+    IOSimpleLockUnlock(nativeRxLock);
+    nativeRxBatch = &batch;
+    for (unsigned n = 0; n < 64; ++n) {
+        Rtw89NativeRx::Frame frame = {};
+        IOSimpleLockLock(nativeRxLock);
+        const bool found = nativeRxQueue.generation() == epoch && nativeRxQueue.pop(frame);
+        const bool current = found && nativeRxQueue.current(frame);
+        if (found) nativeRxQueue.noteDrained(current);
+        IOSimpleLockUnlock(nativeRxLock);
+        if (!found) break;
+        if (current) {
+            // Decoding, key lookups, net80211 and reordering now share the
+            // native gate with lifecycle requests and protocol timers.
+            rtw89LinuxProcessReceivedFrame(&linuxContext, frame.storage);
+        } else {
+            rtw89LinuxReleaseReceivedFrame(frame.storage);
+        }
+    }
+    nativeRxBatch = nullptr;
+    ++nativeRxBatches;
+    IOSimpleLockLock(nativeRxLock);
+    const bool valid = nativeRxQueue.active() && nativeRxQueue.generation() == epoch;
+    bool unstall = false;
+    const bool tx = valid && nativeRxQueue.takeTx(unstall);
+    const bool statistics = nativeRxQueue.takeStats();
+    IOSimpleLockUnlock(nativeRxLock);
+    if (!ml_empty(&batch)) {
+        if (valid) {
+            nativeRxDelivered += batch.ml_len;
+            if_input(&sc.sc_ic.ic_if, &batch);
+            ++nativeRxFlushes;
+        } else {
+            nativeRxPurged += batch.ml_len;
+            ml_purge(&batch);
+        }
+    }
+    if (tx && valid && (sc.sc_flags & RTW89_FLAG_ENABLED)) {
+        if (unstall) ifq_clr_oactive(&sc.sc_ic.ic_if.if_snd);
+        start(&sc.sc_ic.ic_if);
+    }
+    if (statistics) publishNativeRxStatistics();
+    // Coalesce notifications and bound each action to 64 frames. Re-signal
+    // remaining work rather than synchronously waiting on a second workloop.
+    IOSimpleLockLock(nativeRxLock);
+    if (nativeRxEvent && nativeRxQueue.needsService())
+        nativeRxEvent->interruptOccurred(nullptr, nullptr, 0);
+    IOSimpleLockUnlock(nativeRxLock);
+}

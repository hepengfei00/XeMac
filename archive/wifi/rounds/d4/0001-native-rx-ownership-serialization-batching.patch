+/* SPDX-License-Identifier: GPL-2.0 OR BSD-3-Clause */
+#ifndef RTW89_NATIVE_RX_QUEUE_HPP
+#define RTW89_NATIVE_RX_QUEUE_HPP
+#include <stddef.h>
+#include <stdint.h>
+
+namespace Rtw89NativeRx {
+// A successful enqueue transfers storage ownership. The producer frees rejected
+// entries; the consumer/stop path frees accepted entries exactly once.
+struct Frame {
+    void *storage;
+    size_t length;
+    uint32_t epoch;
+};
+
+struct Counters {
+    uint64_t enqueued, drained, fullDrops, closedDrops, staleDrops, invalidDrops;
+    uint32_t highWater;
+    size_t highBytes;
+};
+
+// All methods require the caller's short queue lock. No allocation, protocol
+// processing or blocking workloop-gate acquisition is allowed under that lock.
+class Queue {
+public:
+    static constexpr unsigned capacity = 512;
+    static constexpr size_t byteLimit = 4 * 1024 * 1024;
+    void initialize() {
+        head = count = 0; bytes = 0; epoch = 1;
+        stopped = false; accepting = false;
+        txPending = unstallPending = statsPending = false;
+        counters = {};
+    }
+    bool resume() {
+        if (stopped) return false;
+        ++epoch; accepting = true; return true;
+    }
+    void pause() {
+        accepting = false; ++epoch;
+        txPending = unstallPending = false;
+    }
+    void stop() { pause(); stopped = true; statsPending = false; }
+    uint32_t generation() const { return epoch; }
+    bool active() const { return accepting && !stopped; }
+    bool push(const Frame &frame) {
+        if (!frame.storage || frame.length < 10 || frame.length > 65535) {
+            ++counters.invalidDrops; return false;
+        }
+        if (!active()) { ++counters.closedDrops; return false; }
+        if (frame.epoch != epoch) { ++counters.staleDrops; return false; }
+        if (count == capacity || frame.length > byteLimit - bytes) {
+            ++counters.fullDrops; return false;
+        }
+        frames[(head + count) % capacity] = frame;
+        ++count; bytes += frame.length; ++counters.enqueued;
+        if (count > counters.highWater) counters.highWater = count;
+        if (bytes > counters.highBytes) counters.highBytes = bytes;
+        return true;
+    }
+    bool pop(Frame &frame) {
+        if (!count) return false;
+        frame = frames[head]; frames[head] = {};
+        head = (head + 1) % capacity; --count; bytes -= frame.length;
+        return true;
+    }
+    bool current(const Frame &frame) const { return active() && frame.epoch == epoch; }
+    bool popStale(Frame &frame) {
+        if (!count || current(frames[head])) return false;
+        return pop(frame);
+    }
+    void noteDrained(bool current) {
+        if (current) ++counters.drained; else ++counters.staleDrops;
+    }
+    bool requestTx(bool unstall) {
+        if (!active()) return false;
+        txPending = true; unstallPending |= unstall; return true;
+    }
+    bool requestStats() {
+        if (stopped) return false;
+        statsPending = true; return true;
+    }
+    bool takeTx(bool &unstall) {
+        const bool pending = txPending; unstall = unstallPending;
+        txPending = unstallPending = false; return pending;
+    }
+    bool takeStats() { const bool value = statsPending; statsPending = false; return value; }
+    bool needsService() const { return !stopped && (count || txPending || statsPending); }
+    unsigned depth() const { return count; }
+    size_t queuedBytes() const { return bytes; }
+    const Counters &statistics() const { return counters; }
+private:
+    Frame frames[capacity] {};
+    unsigned head {0}, count {0};
+    size_t bytes {0};
+    uint32_t epoch {0};
+    bool stopped {true}, accepting {false};
+    bool txPending {false}, unstallPending {false}, statsPending {false};
+    Counters counters {};
+};
+}
+#endif

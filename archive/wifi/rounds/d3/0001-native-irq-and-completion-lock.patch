     unsigned long deadline = jiffies + timeout_j;
     IOLockLock(c->lock);
     while (!c->done) {
+        if (time_after_eq(jiffies, deadline)) {
+            /* Every return must release the non-recursive completion lock. */
+            IOLockUnlock(c->lock);
+            return 0;
+        }
         IOLockUnlock(c->lock);
-        if (time_after_eq(jiffies, deadline)) { IOLockLock(c->lock); return 0; }

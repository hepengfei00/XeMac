+#ifdef WTL_BACKEND_ISOLATION
+IOReturn RTWCore89::backendDiagnosticPower(bool on)
+{
+    if (!(sc.sc_flags & RTW89_FLAG_ATTACHED) || !transport)
+        return kIOReturnNotReady;
+    bool ok = true;
+    if (on) ok = rtw89LinuxPowerUp(&linuxContext);
+    else rtw89LinuxPowerDown(&linuxContext);
+    getController()->setProperty("WTLBackendHardwareStarted", linuxContext.started);
+    getController()->setProperty("WTLBackendVifAdded", linuxContext.interfaceAdded);
+    getController()->setProperty("WTLBackendInterruptCount", transport->getInterruptCount(), 64);
+    const bool expected = on ? linuxContext.started && linuxContext.interfaceAdded
+                             : !linuxContext.started && !linuxContext.interfaceAdded;
+    return ok && expected ? kIOReturnSuccess : kIOReturnIOError;
+}
+#endif
 

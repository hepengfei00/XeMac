@@ -0,0 +1,45 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+// Diagnostic-only entry point. No network interface is published by this build.
+IOReturn RTWEthernetController::setProperties(OSObject *properties)
+{
+    if (IOUserClient::clientHasPrivilege(current_task(), kIOClientPrivilegeAdministrator) != kIOReturnSuccess)
+        return kIOReturnNotPrivileged;
+    auto *dictionary = OSDynamicCast(OSDictionary, properties);
+    if (!dictionary || dictionary->getCount() != 1)
+        return kIOReturnBadArgument;
+    auto *command = OSDynamicCast(OSString, dictionary->getObject("WTLBackendCommand"));
+    if (!command || (!command->isEqualTo("power-on") && !command->isEqualTo("power-off")))
+        return kIOReturnBadArgument;
+    if (__atomic_load_n(&backendStopping, __ATOMIC_ACQUIRE) || !backendPowerTimer)
+        return kIOReturnNotReady;
+    if (!__sync_bool_compare_and_swap(&backendBusy, 0, 1))
+        return kIOReturnBusy;
+    if (__atomic_load_n(&backendStopping, __ATOMIC_ACQUIRE)) {
+        __sync_lock_release(&backendBusy);
+        return kIOReturnNotReady;
+    }
+    backendRequestedPower = command->isEqualTo("power-on");
+    setProperty("WTLBackendState", backendRequestedPower ? "power-on-queued" : "power-off-queued");
+    __sync_synchronize();
+    backendPowerTimer->setTimeoutMS(1);
+    return kIOReturnSuccess;
+}
+
+void RTWEthernetController::backendPowerAction(OSObject *object, IOTimerEventSource *)
+{
+    auto *self = OSDynamicCast(RTWEthernetController, object);
+    if (!self) return;
+    if (__atomic_load_n(&self->backendStopping, __ATOMIC_ACQUIRE)) {
+        self->setProperty("WTLBackendState", "stopped");
+        __sync_lock_release(&self->backendBusy);
+        return;
+    }
+    const bool on = self->backendRequestedPower;
+    self->setProperty("WTLBackendState", on ? "power-on-running" : "power-off-running");
+    auto *hal = OSDynamicCast(RTWCore89, self->fHalService);
+    const IOReturn result = hal ? hal->backendDiagnosticPower(on) : kIOReturnUnsupported;
+    self->setProperty("WTLBackendResult", uint64_t(uint32_t(result)), 32);
+    self->setProperty("WTLBackendState", result == kIOReturnSuccess
+                      ? (on ? "power-on-ok" : "power-off-ok") : "failed");
+    __sync_lock_release(&self->backendBusy);
+}

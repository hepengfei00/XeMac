+	    (ctl & TRANS_DDI_MODE_SELECT_MASK) != TRANS_DDI_MODE_SELECT_DP_SST)
+		return 0;
+	port = (ctl & TGL_TRANS_DDI_PORT_MASK) >> TGL_TRANS_DDI_PORT_SHIFT;
+	return port > 0 && xg_display_dvo_port(gXgAuxDisplay, c[16]) == (int)port - 1;

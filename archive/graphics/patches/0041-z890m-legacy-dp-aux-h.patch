+static int
+xg_aux_child_is_active(const unsigned char *c)
+{
+	u32 ctl, port;
+
+	if (gXgAuxDisplay == NULL || DISPLAY_VER(gXgAuxDisplay) != 14)
+		return 0;
+	ctl = intel_de_read(gXgAuxDisplay, TRANS_DDI_FUNC_CTL(gXgAuxDisplay, TRANSCODER_A));
